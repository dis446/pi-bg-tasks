{
  "name": "@dis446/pi-bg-tasks",
  "version": "0.1.0",
  "description": "Background bash tasks for pi: detached commands, progress reporting, wake-on-completion and a live task card",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "background-tasks",
    "long-running",
    "bash",
    "tasks"
  ],
  "license": "MIT",
  "author": "Tsetsen-erdene Ganbaatar <dis446@yahoo.com> (https://github.com/dis446)",
  "homepage": "https://github.com/dis446/pi-bg-tasks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dis446/pi-bg-tasks.git"
  },
  "bugs": {
    "url": "https://github.com/dis446/pi-bg-tasks/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./package.json": "./package.json"
  },
  "types": "./index.ts",
  "files": [
    "core.ts",
    "index.ts",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "video": "https://github.com/dis446/pi-bg-tasks/raw/refs/heads/main/docs/card-demo.mp4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test/resolve.mjs --test test/*.test.ts",
    "test:core": "node --test test/core.test.ts",
    "test:sdk": "node --import ./test/resolve.mjs --test test/sdk.test.ts",
    "ci": "npm run typecheck && npm test",
    "prepublishOnly": "npm run ci && npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "24.19.2",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
